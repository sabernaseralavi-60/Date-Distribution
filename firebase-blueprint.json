{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator marker document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Agricultural product catalog item and pricing configuration.",
      "type": "object",
      "properties": {
        "sku": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "brand": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 120 },
        "packaging": { "type": "string", "maxLength": 120 },
        "netWeightGrams": { "type": "number" },
        "costPrice": { "type": "number" },
        "baseRetailerPrice": { "type": "number" },
        "retailerMarkupPercent": { "type": "number" },
        "directB2cPrice": { "type": "number" },
        "isActive": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sku", "name", "category", "netWeightGrams", "baseRetailerPrice", "directB2cPrice", "isActive", "ownerId", "createdAt"]
    },
    "LedgerSnapshot": {
      "title": "LedgerSnapshot",
      "description": "Synchronized business ledger snapshot owned by an authenticated user or administrator.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "version": { "type": "number" },
        "summaryJson": { "type": "string", "maxLength": 900000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "version", "summaryJson", "createdAt", "updatedAt"]
    },
    "AuditEntry": {
      "title": "AuditEntry",
      "description": "Immutable operational audit log record.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "maxLength": 120 },
        "entityType": { "type": "string", "maxLength": 120 },
        "entityId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "details": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "action", "entityType", "entityId", "details", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Administrator registry keyed by user UID."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog entries."
    },
    "/ledger_snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/LedgerSnapshot" },
      "description": "Per-user or global business state snapshots."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditEntry" },
      "description": "Immutable audit trail entries."
    }
  }
}
