rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'saber.naseralavi@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 256
        && data.createdAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['sku', 'name', 'category', 'netWeightGrams', 'baseRetailerPrice', 'directB2cPrice', 'isActive', 'ownerId', 'createdAt'])
        && data.keys().hasOnly(['sku', 'name', 'brand', 'category', 'packaging', 'netWeightGrams', 'costPrice', 'baseRetailerPrice', 'retailerMarkupPercent', 'directB2cPrice', 'isActive', 'ownerId', 'createdAt', 'updatedAt'])
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64 && data.sku.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && (!('brand' in data) || (data.brand is string && data.brand.size() <= 120))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 120
        && (!('packaging' in data) || (data.packaging is string && data.packaging.size() <= 120))
        && data.netWeightGrams is number && data.netWeightGrams > 0 && data.netWeightGrams <= 1000000
        && (!('costPrice' in data) || (data.costPrice is number && data.costPrice >= 0))
        && data.baseRetailerPrice is number && data.baseRetailerPrice >= 0
        && (!('retailerMarkupPercent' in data) || (data.retailerMarkupPercent is number && data.retailerMarkupPercent >= 0 && data.retailerMarkupPercent <= 500))
        && data.directB2cPrice is number && data.directB2cPrice >= 0
        && data.isActive is bool
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidLedgerSnapshot(data) {
      return data.keys().hasAll(['ownerId', 'version', 'summaryJson', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'version', 'summaryJson', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.version is number && data.version >= 1
        && data.summaryJson is string && data.summaryJson.size() >= 2 && data.summaryJson.size() <= 900000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditEntry(data) {
      return data.keys().hasAll(['actorUid', 'action', 'entityType', 'entityId', 'details', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'action', 'entityType', 'entityId', 'details', 'createdAt'])
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 && data.actorUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.actorUid == request.auth.uid
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 120
        && data.entityType is string && data.entityType.size() >= 1 && data.entityType.size() <= 120
        && data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128 && data.entityId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 2000
        && data.createdAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isBootstrappedAdmin());
      allow list: if false;
      allow create: if isBootstrappedAdmin() && isValidId(adminId) && adminId == request.auth.uid && isValidAdminUser(incoming()) && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isBootstrappedAdmin();
      allow create: if isVerifiedUser() && isValidId(productId) && isValidProduct(incoming()) && incoming().createdAt == request.time && isAdmin();
      allow update: if isVerifiedUser() && isValidId(productId) && isValidProduct(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().ownerId == existing().ownerId
        && incoming().sku == existing().sku
        && ('updatedAt' in incoming()) && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'brand', 'category', 'packaging', 'netWeightGrams', 'costPrice', 'baseRetailerPrice', 'retailerMarkupPercent', 'directB2cPrice', 'isActive', 'updatedAt'])
        && isAdmin();
      allow delete: if false;
    }

    match /ledger_snapshots/{snapshotId} {
      allow get: if isVerifiedUser() && isValidId(snapshotId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(snapshotId) && snapshotId == request.auth.uid && isValidLedgerSnapshot(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(snapshotId) && snapshotId == request.auth.uid && isValidLedgerSnapshot(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['version', 'summaryJson', 'updatedAt']);
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && (existing().actorUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && existing().actorUid == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(logId) && isValidAuditEntry(incoming()) && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
