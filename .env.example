# Copy to .env for local development. Never commit .env. On Vercel set these in Project > Settings > Environment Variables.

# Required in production: at least 32 random characters (signs the session cookie).
SESSION_SECRET=
# Required the first time the database is empty: the administrator login (username below, at least 10 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# PostgreSQL (Neon). On Vercel the Neon integration sets POSTGRES_URL / DATABASE_URL for you.
# Without it a local embedded database is written to DATA_DIR (single machine only).
DATABASE_URL=
DATA_DIR=./data/pglite
# Demo business of the spec (Part 45): 6 agents, 12 stores, 200 packages. NEVER use on a real business.
SEED_DEMO=false
# Password of the demo agent/store logins (agent1..agent6, rt01..rt12); required when SEED_DEMO=true.
SEED_PASSWORD=
PORT=3000
