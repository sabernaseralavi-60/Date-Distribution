# GEMINI_API_KEY: Optional runtime key injected by AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where the application is hosted
APP_URL="http://localhost:3000"

# DATABASE_URL: Optional PostgreSQL connection string for external Neon/Supabase deployment (see drizzle/0000_saber_dates_schema.sql)
DATABASE_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/saber_dates?sslmode=require"

# R2 / S3 Object Storage variables for external private document bucket deployment
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="saber-dates-private-documents"
